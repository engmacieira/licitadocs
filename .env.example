# 🌍 AMBIENTE E INFRAESTRUTURA
ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*

# 🗄️ SUPABASE (BANCO DE DADOS E AUTH)
# Substitua pelos valores do seu painel Supabase
DATABASE_URL=postgresql://postgres:[SENHA]@db.[PROJECT_ID].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_KEY=[SUPABASE_ANON_OR_SERVICE_KEY]
SUPABASE_JWT_SECRET=[JWT_SECRET_FROM_SUPABASE_SETTINGS]

# 🔐 SEGURANÇA GERAL (LEGADO/RESET)
SECRET_KEY=[CHAVE_ALEATORIA_PARA_RESET_SENHA]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=10

# 🚀 INTEGRAÇÕES ATUAIS
GOOGLE_API_KEY=
GITHUB=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 📦 MENSAGERIA E COMUNICAÇÃO
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=LicitaDocs
ADMIN_EMAIL_NOTIFICATIONS=

# 📱 WHATSAPP
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# 💰 PAGAMENTOS (INFINITE PAY)
INFINITEPAY_API_KEY=
INFINITEPAY_WEBHOOK_SECRET=
