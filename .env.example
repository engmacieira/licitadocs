# ==========================================
# 🌍 AMBIENTE E INFRAESTRUTURA
# ==========================================
# Opções: development, staging, production
ENV=

# Frontend conectado a esta API (Sem barra no final)
FRONTEND_URL=

# Origens permitidas no CORS (separadas por vírgula, sem espaços)
CORS_ORIGINS=

# Caminho para armazenamento local de arquivos (se aplicável)
STORAGE_PATH=

# ==========================================
# 🗄️ BANCO DE DADOS
# ==========================================
# String de conexão principal (Local ou Nuvem)
DATABASE_URL=
SUPABASE_KEY=
SUPABASE_URL=

# Credenciais específicas da AWS RDS (Se o banco estiver lá)
BANCO_AWS=
SENHA_AWS=

# ==========================================
# 🔐 SEGURANÇA GERAL
# ==========================================
# Chave mestra para assinar os tokens JWT (Gere com: openssl rand -hex 32)
SECRET_KEY=

# ==========================================
# 👁️ SENTRY
# ==========================================
SENTRY_DSN=

# ==========================================
# OAuth
# ==========================================
# GOOGLE
GOOGLE_ID_do_cliente=
GOOGLE_Chave_secreta_do_cliente=

# AZURE
AZURE_ID_do_aplicativo=
AZURE_Chave_secreta_do_client=



# ==========================================
# 🚀 INTEGRAÇÕES ATUAIS (Terceiros)
# ==========================================
# API do Google (Ex: para RAG/Gemini ou Maps)
GOOGLE_API_KEY=
JULES_AI_API_KEY=
JULES_API_KEY=
$env:JULES_API_KEY=

# Integração com GitHub (Ex: Webhooks, CI/CD)
GITHUB=
JULES_PAT=

# Alertas via Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 📦 INTEGRAÇÕES E COMUNICAÇÃO
# ==========================================

# --- 1. Mensageria e E-mail ---
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=
ADMIN_EMAIL_NOTIFICATIONS=

# --- 2. WhatsApp ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE=
WHATSAPP_ENABLED=false
WHATSAPP_TIMEOUT_SECONDS=15
DOCUMENT_EXPIRATION_ALERT_DAYS=15

# --- 3. Pagamentos Infinite Pay ---
INFINITEPAY_API_KEY=
INFINITEPAY_WEBHOOK_SECRET=

# ==========================================
# SEGURANÇA GLOBAL
# ==========================================

ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
RESET_TOKEN_EXPIRE_MINUTES=
SENHA_PROJETO_SUPABASE=